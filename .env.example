# Copie este archivo a `.env` y complete la clave del proveedor que vaya a usar.
# Solo hace falta para la corrida real. Las pruebas corren sin clave ni conexión.

# ── Por defecto · OpenAI ────────────────────────────────────────────────────
# De pago, con su propia clave en platform.openai.com. El taller lo usa por
# omisión porque responde en 7–8 segundos y siempre produce salida estructurada.
PROVIDER=openai
MODEL=gpt-5.4-mini
OPENAI_API_KEY=

# ── Alternativa · Google Gemini ─────────────────────────────────────────────
# Clave gratuita, sin tarjeta, en Google AI Studio. Sirve, pero su capa gratuita
# se satura: devuelve 503 y la corrida muere en el tope de pasos sin que haya
# nada mal en el código. Para cambiar: PROVIDER=google y MODEL=gemini-3.1-flash-lite
# GOOGLE_API_KEY=

# ── Opcionales ──────────────────────────────────────────────────────────────
# El evaluador puede usar otro proveedor que el agente.
# JUDGE_PROVIDER=
# JUDGE_MODEL=

# Tope de vueltas del bucle. Bajarlo a 2 demuestra el corte. Con 3, gpt-5.4-mini
# alcanza a terminar porque pide varias cotizaciones en un mismo paso; Gemini,
# que las pide una por vuelta, no.
# MAX_STEPS=12
