{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  // `solutions/` y `scripts/gaps/` son plantillas: importan rutas relativas a
  // `src/` y solo compilan una vez copiadas ahí. El script de intercambio las
  // verifica en su lugar.
  "include": ["src/**/*.ts", "tests/**/*.ts", "scripts/*.ts"]
}
